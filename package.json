{
  "name": "node-express-multitenant",
  "version": "3.0.0",
  "description": "Shared database strategy multi tenancy package",
  "author": "Shaul Zuarets (https://www.linkedin.com/in/shaul-zuarets-1a789918/)",
  "contributors": [
    "Yakir Gottesman (https://www.linkedin.com/in/yakirgot/)"
  ],
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "express",
    "prisma",
    "shared database",
    "multitenant",
    "multi-tenant",
    "multitenancy",
    "multi",
    "tenant",
    "SaaS"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "build": "tsup",
    "build:dev": "tsup --watch",
    "watch": "tsup --watch",
    "prepare": "husky || true",
    "generate": "prisma generate",
    "createdb": "prisma generate && prisma migrate deploy",
    "prepublishOnly": "npm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shauliz/node-express-multitenant.git"
  },
  "bugs": {
    "url": "https://github.com/shauliz/node-express-multitenant/issues"
  },
  "homepage": "https://github.com/shauliz/node-express-multitenant#readme",
  "prisma": {
    "schema": "./src/app/prisma/schema.prisma"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "@prisma/client": "^6.19.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
